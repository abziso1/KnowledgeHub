server {
    listen 8080 ssl;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 12m;

    ssl_certificate /etc/knowledgehub/tls/${KH_TLS_CERT_FILE};
    ssl_certificate_key /etc/knowledgehub/tls/${KH_TLS_KEY_FILE};
    ssl_protocols TLSv1.2 TLSv1.3;

    resolver 127.0.0.11 valid=10s ipv6=off;
    location /api/ {
        set $api_backend http://backend:8080;
        proxy_pass $api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Forwarded-Prefix "";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    error_page 413 = @file_too_large;
    location @file_too_large {
        default_type application/json;
        return 413 '{"code":"FILE_TOO_LARGE","message":"上传文件超过大小限制"}';
    }
}
