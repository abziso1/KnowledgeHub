KH_DB_NAME=knowledgehub
KH_DB_USERNAME=knowledgehub
KH_DB_PASSWORD=replace-with-a-database-password
KH_ADMIN_USERNAME=admin
KH_ADMIN_PASSWORD=replace-with-an-admin-password

KH_WEB_BIND=127.0.0.1
KH_WEB_PORT=8080
KH_WEB_MODE=http
KH_SESSION_SECURE=false

# Set an absolute or repository-relative directory containing the TLS files when using HTTPS.
# KH_TLS_DIR=./tls
# KH_TLS_CERT_FILE=server.crt
# KH_TLS_KEY_FILE=server.key
